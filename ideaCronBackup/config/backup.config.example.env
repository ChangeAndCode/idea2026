# Copia este archivo como config/.env y completa los valores.

NODE_ENV=development
TZ=America/Mexico_City

MONGODB_URI=
MONGODB_DATABASE=idea

# Destino exclusivo para pruebas de restauración; nunca debe ser producción.
RESTORE_MONGODB_URI=
RESTORE_MONGODB_DATABASE=idea_restore_test
RESTORE_UPLOAD_DIR=
RESTORE_ALLOW_DROP=false

# Carpeta real usada por ideabackend para archivos subidos.
UPLOAD_DIR=

# Pruebas: pueden ser dos carpetas distintas del escritorio.
BACKUP_LOCAL_DIR=
BACKUP_EXTERNAL_DIR=
BACKUP_EXTERNAL_TYPE=filesystem

# Raíz del repositorio que se incluirá en el snapshot del sistema.
# Por defecto, desde ideaCronBackup se utiliza la carpeta padre.
SNAPSHOT_SOURCE_DIR=

BACKUP_CRON_SCHEDULE=0 3 * * *
BACKUP_RETENTION_LOCAL_DAYS=7
BACKUP_RETENTION_EXTERNAL_DAYS=30

BACKUP_COMPRESSION=gzip
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=

BACKUP_VERIFY_CHECKSUM=true
BACKUP_VERIFY_EXTERNAL_COPY=true

BACKUP_LOG_DIR=
BACKUP_LOG_LEVEL=info

BACKUP_ALERTS_ENABLED=false
BACKUP_ALERT_WEBHOOK_URL=

BACKUP_SYSTEM_NAME=idea2026
BACKUP_ENVIRONMENT=local
